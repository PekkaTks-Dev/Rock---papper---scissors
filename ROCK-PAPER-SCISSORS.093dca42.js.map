    </div>
  `;
    let elected = false;
    let counter = 3;
    const timerEl = section.querySelector("#timer");
    const interval = setInterval(()=>{
        counter--;
        if (counter > 0) timerEl.textContent = String(counter);
        else {
            clearInterval(interval);
            if (!elected) goTo("/rules"); // Si no eligió a tiempo, vuelve a reglas
        }
    }, 1000);
    section.querySelectorAll(".hand-btn").forEach((btn)=>{
        btn.addEventListener("click", (e)=>{
            elected = true;
            clearInterval(interval);
            const chosenPlay = e.currentTarget.dataset.play;
            (0, $0b89d474933103bc$export$ca000e230c0caa3e).setMove(chosenPlay);
            goTo("/result");
        });
    });
    return section;
}



