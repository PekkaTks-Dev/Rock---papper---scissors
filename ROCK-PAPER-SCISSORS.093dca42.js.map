const $0b89d474933103bc$export$ca000e230c0caa3e = {
    data: {
        currentGame: {
            myPlay: "",
            computerPlay: "",
            result: ""
        },
        history: {
            myScore: 0,
            computerScore: 0
        }
    },
    listeners: [],
    init () {
        const saved = localStorage.getItem("rps_history");
        if (saved) this.data.history = JSON.parse(saved);
    },
    getState () {
        return this.data;
    },
    setState (newState) {
        this.data = newState;
        localStorage.setItem("rps_history", JSON.stringify(this.data.history));
        for (const cb of this.listeners)cb(this.data);
    },
    subscribe (callback) {
        this.listeners.push(callback);
    },
    setMove (myPlay) {
        const moves = [
            "piedra",
            "papel",
            "tijera"
        ];
        const computerPlay = moves[Math.floor(Math.random() * 3)];
        let result = "empate";
        if (myPlay === "piedra" && computerPlay === "tijera" || myPlay === "papel" && computerPlay === "piedra" || myPlay === "tijera" && computerPlay === "papel") result = "ganaste";
        else if (myPlay !== computerPlay) result = "perdiste";
        const currentHistory = {
            ...this.data.history
        };
        if (result === "ganaste") currentHistory.myScore += 1;
        if (result === "perdiste") currentHistory.computerScore += 1;
        this.setState({
            ...this.data,
            currentGame: {
                myPlay: myPlay,
                computerPlay: computerPlay,
                result: result
            },
            history: currentHistory
        });
    }
};


